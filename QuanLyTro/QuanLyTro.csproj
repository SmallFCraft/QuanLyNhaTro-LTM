<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Do not compile nested sub-projects -->
  <ItemGroup>
    <Compile Remove="QuanLyTro.Shared\**" />
    <Compile Remove="QuanLyTro.Server\**" />
    <Compile Remove="QuanLyTro.Tests\**" />
    <EmbeddedResource Remove="QuanLyTro.Shared\**" />
    <EmbeddedResource Remove="QuanLyTro.Server\**" />
    <EmbeddedResource Remove="QuanLyTro.Tests\**" />
    <None Remove="QuanLyTro.Shared\**" />
    <None Remove="QuanLyTro.Server\**" />
    <None Remove="QuanLyTro.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="QuanLyTro.Shared\QuanLyTro.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\wwwroot\**" Exclude="Assets\wwwroot\**\*.map">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- FE chỉ là tài nguyên hiển thị: nếu thiếu file do quên copy, build fail rõ ràng thay vì WebView2 trắng trang. -->
  <Target Name="KiemTraAssetsWwwroot" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <WwwrootFiles Include="Assets\wwwroot\auth\index.html;Assets\wwwroot\chutro\index.html;Assets\wwwroot\congan\index.html;Assets\wwwroot\khachthue\index.html;Assets\wwwroot\shared\js\bridge.js;Assets\wwwroot\shared\js\ui.js" />
    </ItemGroup>
    <Error Condition="!Exists('%(WwwrootFiles.Identity)')" Text="Thiếu file FE: %(WwwrootFiles.Identity)" />
  </Target>

</Project>
