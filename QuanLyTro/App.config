<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Hạ tầng do nhà phát triển cấu hình; người dùng cuối không nhập IP/Port trên UI. -->
    <add key="ServerHost" value="127.0.0.1" />
    <add key="ServerPort" value="8888" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
